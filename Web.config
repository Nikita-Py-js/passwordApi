<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="EncryptionKey" value=""/>
    <add key="DefaultTtlMinutes" value="1440"/>
    <add key="MaxTtlMinutes" value="10080"/>
    <add key="MaxSecretSize" value="65536"/>
    <add key="BaseUrl" value=""/>
    <add key="ApiKey" value=""/>
    <add key="ApiAllowedIps" value="127.0.0.1,::1"/>
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.7.2"/>
    <httpRuntime targetFramework="4.7.2"
                 maxRequestLength="1024"
                 requestValidationMode="4.5"/>

    <!-- Продакшен: наружу не уходят стектрейсы и пути.
         Локально (с самого сервера) детали видны — удобно для отладки.
         Если отладка не нужна вообще — замените на mode="On". -->
    <customErrors mode="RemoteOnly" defaultRedirect="/passwordApi/View.ashx"/>

    <globalization requestEncoding="utf-8"
                   responseEncoding="utf-8"
                   fileEncoding="utf-8"/>
  </system.web>

  <system.webServer>
    <!-- Не даём IIS подменять ответы приложения (4xx/5xx) своими страницами.
         Безопасно вместе с customErrors="RemoteOnly" / "On". -->
    <httpErrors existingResponse="PassThrough"/>

    <defaultDocument>
      <files>
        <clear/>
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By"/>
        <remove name="X-AspNet-Version"/>
        <add name="X-Content-Type-Options" value="nosniff"/>
        <add name="X-Frame-Options" value="DENY"/>
        <add name="Referrer-Policy" value="no-referrer"/>
        <add name="Content-Security-Policy"
             value="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"/>
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true"/>
          <add verb="POST" allowed="true"/>
          <add verb="HEAD" allowed="true"/>
        </verbs>
        <requestLimits maxAllowedContentLength="102400"/>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
